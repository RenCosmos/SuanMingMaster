{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:suanming:ten-god-evidence:context:v1",
  "title":"分层十神证据context",
  "type":"object","required":["schema_version","view","view_schema","source_checksum","selection","reading","base_context"],
  "properties":{
    "schema_version":{"const":"suanming-context/v1"},"view":{"const":"evidence_page"},"view_schema":{"const":"suanming-ten-god-evidence/v1"},"source_checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "selection":{"type":"object","required":["page","base_checksum"],"properties":{"page":{"const":"ten-gods"}}},
    "base_context":{"type":"object","required":["required","source_checksum"],"properties":{"required":{"const":true}}},
    "reading":{"type":"object","required":["ten_god_evidence"],"properties":{"ten_god_evidence":{"type":"object","required":["coverage","day_master","natal","current_dayun","interpretation_rules"],"properties":{
      "natal":{"type":"object","required":["scope","known_pillars","uncertain_pillars"],"properties":{"scope":{"const":"natal"},"known_pillars":{"type":"array","maxItems":4,"items":{"type":"object","required":["id","ganzhi","visible","hidden"],"properties":{"visible":{"$ref":"#/$defs/visible"},"hidden":{"type":"array","items":{"$ref":"#/$defs/hidden"}}}}},"uncertain_pillars":{"type":"array","maxItems":4}}},
      "current_dayun":{"type":"object","required":["scope","target_date","status","variants"],"properties":{"scope":{"const":"current_dayun"},"status":{"enum":["stable","varies","single_candidate"]},"variants":{"type":"array","minItems":1,"items":{"type":"object","required":["status","candidate_ids"],"properties":{"visible":{"$ref":"#/$defs/visible"},"hidden":{"type":"array","items":{"$ref":"#/$defs/hidden"}}}}}}}
    }}}}
  },
  "$defs":{
    "visible":{"type":"object","required":["stem","ten_god","source_id","field"],"properties":{"field":{"const":"stem"}}},
    "hidden":{"type":"object","required":["stem","ten_god","source_id","field","index"],"properties":{"field":{"const":"hidden_stems"},"index":{"type":"integer","minimum":0,"maximum":2}}}
  }
}
