{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:suanming:partner-search-batch:output:v1",
  "title":"批量日期查询的有界响应",
  "type":"object","additionalProperties":false,
  "required":["ok","partial","workflow_version","adapter_id","validation","cache_hit","calculation_performed","files","task_id","context","next_actions","output"],
  "properties":{
    "ok":{"type":"boolean"},"partial":{"type":"boolean"},"workflow_version":{"type":"string"},
    "adapter_id":{"const":"partner_search_batch"},
    "validation":{"type":"object","required":["ok","completed_jobs_validated","recalculated"],"properties":{"ok":{"type":"boolean"},"completed_jobs_validated":{"const":true},"recalculated":{"type":"boolean"}}},
    "cache_hit":{"type":"boolean"},"calculation_performed":{"type":"boolean"},
    "files":{"type":"object","required":["chart","context"],"additionalProperties":false,"properties":{"chart":{"type":"string"},"context":{"type":"string"}}},
    "task_id":{"type":"string","pattern":"^SMB-[a-f0-9]{12}$"},
    "error":{"type":"object","required":["month","error"],"properties":{"month":{"type":"string"},"error":{"type":"string","maxLength":240}}},
    "temporary_input_removed":{"const":true},
    "next_actions":{"type":"array","items":{"$ref":"#/$defs/action"}},
    "output":{"type":"object","required":["max_bytes","bytes","effective_limit"],"properties":{"max_bytes":{"const":20480},"bytes":{"type":"integer","minimum":1,"maximum":20480},"effective_limit":{"type":"integer","minimum":1,"maximum":13},"budget_adjusted":{"type":"boolean"}}},
    "context":{
      "type":"object",
      "required":["schema_version","source_checksum","computed_complete","scope","ranking","filters","condition_count","evidence_scope","candidate_birth_time_is_hypothetical","selected_partner","probability","progress"],
      "properties":{
        "schema_version":{"const":"suanming-partner-search-batch-context/v1"},
        "source_checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},"computed_complete":{"type":"boolean"},
        "scope":{"type":"object","required":["start","end","timezone","candidate_year_branch"]},
        "ranking":{"enum":["monthly_top","global_top","all"]},
        "filters":{"$ref":"urn:suanming:partner-search:input:v1#/properties/filters"},
        "condition_count":{"type":"integer","minimum":1,"maximum":5},
        "evidence_scope":{"type":"string"},"candidate_birth_time_is_hypothetical":{"const":true},
        "selected_partner":{"type":"null"},"probability":{"type":"null"},
        "progress":{"type":"object","required":["completed_months","total_months","pending_months"]},
        "summary_page_complete":{"type":"boolean"},
        "months_page":{"type":"object","required":["total","offset","returned","next_offset"]},
        "months":{"type":"array","maxItems":13,"items":{"type":"object","required":["month","status","date_page","dates"],"properties":{"month":{"type":"string","pattern":"^\\d{4}-\\d{2}$"},"status":{"enum":["completed","not_completed"]},"date_page":{"type":"object","required":["total","returned","next_offset"]},"dates":{"type":"array","items":{"$ref":"#/$defs/date_row"}}}}},
        "date_detail":{"type":"object","required":["schema_version","selection","birth_time_is_hypothetical","candidates"],"properties":{"schema_version":{"const":"suanming-partner-search-batch-date-context/v1"},"birth_time_is_hypothetical":{"const":true}}}
      },
      "oneOf":[{"required":["months","months_page"],"not":{"required":["date_detail"]}},{"required":["date_detail"],"not":{"required":["months"]}}]
    }
  },
  "allOf":[
    {"if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"partial":{"const":false},"context":{"properties":{"computed_complete":{"const":true}}},"validation":{"properties":{"ok":{"const":true}}}}}},
    {"if":{"properties":{"partial":{"const":true}}},"then":{"properties":{"ok":{"const":false},"validation":{"properties":{"ok":{"const":false}}}}}}
  ],
  "$defs":{
    "action":{"type":"object","required":["action","entrypoint","argv"],"properties":{"action":{"const":"reuse"},"entrypoint":{"const":"scripts/mobile.sh"},"argv":{"type":"array","minItems":4,"items":{"type":"string"}}}},
    "date_row":{"type":"object","required":["date","year_pillars","day_pillars","max_matched","conditions_at_best","matching_samples","best_samples","hour_variant_count","sample_shared_risk_types","sample_conditional_risk_types","details"],"properties":{
      "date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"year_pillars":{"type":"array","minItems":1,"items":{"type":"string"}},"day_pillars":{"type":"array","minItems":1,"items":{"type":"string"}},
      "max_matched":{"type":"integer","minimum":1,"maximum":5},"conditions_at_best":{"type":"array","minItems":1,"items":{"type":"array","items":{"type":"string"}}},
      "matching_samples":{"type":"integer","minimum":1},"best_samples":{"type":"integer","minimum":1},"hour_variant_count":{"type":"integer","minimum":1},
      "sample_shared_risk_types":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"sample_conditional_risk_types":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"details":{"$ref":"#/$defs/action"}
    }}
  },
  "$comment":"只有全部月份核验完成才ok=true。分页不丢索引；完整候选留在月份chart。共同/条件风险基于实际命中采样关系签名，不是所有连续时刻或现实吉凶判定。"
}
