{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:suanming:bazi-detail-context:v1",
  "title":"程序八字专业细盘补充页",
  "type":"object",
  "required":["schema_version","view","view_schema","source_checksum","selection","reading","base_context"],
  "properties":{
    "schema_version":{"const":"suanming-context/v1"},
    "view":{"const":"evidence_page"},
    "view_schema":{"const":"suanming-bazi-detail-context/v1"},
    "source_checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "selection":{"type":"object","required":["page","base_checksum"],"properties":{"page":{"enum":["bazi-detail","bazi-periods"]},"base_checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "base_context":{"type":"object","required":["required","source_checksum"],"properties":{"required":{"const":true}}},
    "reading":{"oneOf":[
      {"type":"object","required":["bazi_detail"],"properties":{"bazi_detail":{
        "type":"object","required":["schema_version","rule_version","coverage","day_master","conventions","natal","auxiliary","month_commander","qiyun","at_target","supported_shensha","sources"],
        "properties":{"schema_version":{"const":"suanming-bazi-detail/v1"},"rule_version":{"const":"bazi-professional/1.0.0"},"natal":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/row"}},"month_commander":{"type":"object","required":["rule_id","stem","schedule","distinct_from_month_main_qi"],"properties":{"distinct_from_month_main_qi":{"const":true}}},"supported_shensha":{"type":"array","minItems":14,"maxItems":14}}
      }}},
      {"type":"object","required":["bazi_periods"],"properties":{"bazi_periods":{"type":"object","required":["rule_version","total","offset","limit","next_offset","items","computed_annual_years","coverage"],"properties":{"total":{"type":"integer","minimum":0},"next_offset":{"type":["integer","null"]},"items":{"type":"array","maxItems":10,"items":{"$ref":"#/$defs/row"}}}}}}
    ]}
  },
  "$defs":{
    "row":{"type":"object","required":["id","ganzhi","stem_ten_god","hidden_stems","hidden_ten_gods","nayin","star_fortune","self_seat","xun","xun_kong","void_by_natal","shensha"],"properties":{
      "ganzhi":{"type":"string","minLength":2,"maxLength":2},
      "star_fortune":{"$ref":"#/$defs/stage"},"self_seat":{"$ref":"#/$defs/stage"},
      "xun_kong":{"type":"string","minLength":2,"maxLength":2},
      "shensha":{"type":"array","maxItems":14,"items":{"type":"object","required":["rule_id","name","source","references"],"properties":{"references":{"type":"array","minItems":1,"items":{"type":"object","required":["source_id","field","target_field"],"properties":{"field":{"enum":["stem","branch"]},"target_field":{"enum":["stem","branch"]}}}}}}}
    }},
    "stage":{"enum":["长生","沐浴","冠带","临官","帝旺","衰","病","死","墓","绝","胎","养"]}
  }
}
