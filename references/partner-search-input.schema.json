{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:suanming:partner-search:input:v1",
  "title":"正缘候选筛选输入（不是身份或生日预测）",
  "type":"object","additionalProperties":false,
  "required":["mode","self","as_of","search"],
  "properties":{
    "mode":{"const":"partner_search"},"label":{"type":"string","maxLength":80},"question":{"type":"string","maxLength":1000},
    "as_of":{"$ref":"#/$defs/date"},"partner_star_model":{"enum":["all","wealth","authority"],"default":"all"},
    "self":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["birth"],"properties":{"birth":{"$ref":"#/$defs/birth"},"options":{"$ref":"#/$defs/options"},"chart_mode":{"enum":["bazi","both"],"default":"bazi"}}},
      {"type":"object","additionalProperties":false,"required":["pillars","birth_year"],"properties":{"pillars":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string","pattern":"^[甲乙丙丁戊己庚辛壬癸][子丑寅卯辰巳午未申酉戌亥]$"}},"birth_year":{"type":"integer","minimum":1900,"maximum":2100}}}
    ]},
    "search":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"years"},"year_range":{"$ref":"#/$defs/years"},"timezone":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","start","end"],"properties":{"type":{"const":"dates"},"start":{"$ref":"#/$defs/date"},"end":{"$ref":"#/$defs/date"},"timezone":{"type":"string"},"longitude":{"type":"number","minimum":-180,"maximum":180},"longitude_source":{"type":"string","minLength":1,"maxLength":400},"options":{"$ref":"#/$defs/options"},"time_uncertainty":{"oneOf":[
        {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"unknown"}}},
        {"type":"object","additionalProperties":false,"required":["type","start","end"],"properties":{"type":{"const":"range"},"start":{"$ref":"#/$defs/time"},"end":{"$ref":"#/$defs/time"},"end_day_offset":{"const":0}}},
        {"type":"object","additionalProperties":false,"required":["type","times"],"properties":{"type":{"const":"candidates"},"times":{"type":"array","minItems":1,"maxItems":48,"uniqueItems":true,"items":{"$ref":"#/$defs/time"}}}}
      ]}}},
      {"type":"object","additionalProperties":false,"required":["type","people"],"properties":{"type":{"const":"people"},"people":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["id","birth"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9-]{1,32}$"},"birth":{"$ref":"#/$defs/birth"},"options":{"$ref":"#/$defs/options"}}}}}}
    ]},
    "filters":{"type":"object","additionalProperties":false,"properties":{
      "conditions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["zodiac_affinity","spouse_branch_liuhe","day_stem_five_combine","partner_star_projection","element_supply"]}},
      "match":{"enum":["any","all"],"default":"any"},
      "exclude_relations":{"type":"array","uniqueItems":true,"items":{"enum":["地支六冲","地支六害","地支六破","相刑（成对规则）","三刑齐全","自刑（采用本规则表）"]}},
      "preferred_elements":{"type":"array","uniqueItems":true,"items":{"enum":["木","火","土","金","水"]}},
      "year_gap":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":-100,"maximum":100}}
    }}
  },
  "$defs":{
    "date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "time":{"type":"string","pattern":"^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"},
    "years":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1900,"maximum":2100}},
    "birth":{"type":"object","additionalProperties":false,"required":["calendar","date","time","gender","timezone"],"properties":{"calendar":{"enum":["solar","lunar"]},"date":{"$ref":"#/$defs/date"},"time":{"$ref":"#/$defs/time"},"gender":{"enum":["male","female"]},"timezone":{"type":"string","minLength":1},"is_leap_month":{"type":"boolean"},"longitude":{"type":"number","minimum":-180,"maximum":180},"longitude_source":{"type":"string","minLength":1,"maxLength":400}}},
    "options":{"type":"object","additionalProperties":false,"properties":{"time_basis":{"enum":["clock","true_solar"]},"bazi_day_boundary":{"enum":["midnight","late_zi"]},"bazi_hour_stem_rule":{"enum":["day_stem","library"]},"ziwei_day_boundary":{"enum":["midnight","late_zi"]},"ziwei_year_boundary":{"enum":["lunar_new_year","lichun"]},"ziwei_leap_adjust":{"type":"boolean"},"ziwei_algorithm":{"enum":["default","zhongzhou"]},"dayun_count":{"type":"integer","minimum":1,"maximum":12},"annual_count":{"type":"integer","minimum":1,"maximum":20}}}
  },
  "$comment":"本程序还校验真实日期/时区/闰月、干支阴阳/五虎遁/五鼠遁、年柱与公历年、端点先后/跨度、人物ID唯一、真太阳时经度、element_supply需用户显式五行及候选四柱。CLI --source-chart 导入前的请求不带self，导入后符合本schema。默认as_of禁止使用服务器日期。"
}
